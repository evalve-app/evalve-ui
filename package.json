{
  "name": "evalve-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "gen:api": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "gen:tokens": "node scripts/build-tokens.mjs",
    "test": "vitest run",
    "lint": "eslint . && node scripts/check-glossary.mjs && node scripts/check-css-tokens.mjs",
    "screenshot": "node --env-file-if-exists=.env.local scripts/screenshot.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.0",
    "lucide-react": "1.61.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "openapi-typescript": "7.13.0",
    "playwright-core": "^1.65.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
