# Copy to .env to point the dev server at a different Kitaru server.
KITARU_URL=https://34-196-198-190.sslip.io

# The Evalve backend for /evalve requests. Without it, the dev server uses the
# KITARU_URL host, as the AWS deploy does.
# EVALVE_URL=http://localhost:8100

# For `npm run screenshot` (see .claude/skills/run/SKILL.md). Put these in
# .env.local, which git ignores. Use an account that is safe for an agent.
# KITARU_TEST_USERNAME=
# KITARU_TEST_PASSWORD=
